#include <stdio.h>

typedef struct sinhVien{
    char hoTen[51];
    double diemtb;
} sv;

void merge (sv arr[], sv tmp[], int l, int m, int r){
    int i = l, k = l;
    int j = m + 1;
    while (i <= m && j <= r){
        if (arr[i].diemtb >= arr[j].diemtb){
            tmp[k++] = arr[i++];
        }
        else tmp[k++] = arr[j++];
    }
    while (i <= m) tmp[k++] = arr[i++];
    while (j <= r) tmp[k++] = arr[j++];
    for (int t = l; t <= r; t++){
        arr[t] = tmp[t];
    }
}

void mergersort (sv arr[], sv tmp[], int l, int r){
    if (l >= r) return;
    int m = (l + r) / 2;
    mergersort(arr, tmp, l, m);
    mergersort(arr, tmp, m + 1, r);
    merge(arr, tmp, l, m, r);
}

int main (){
    int n;
    scanf("%d", &n);
    sv a[n], tmp[n];
    
    for (int i = 0; i < n; i++){
        scanf("%s%lf", a[i].hoTen, &a[i].diemtb);
    }
    mergersort(a, tmp, 0, n - 1);
    
    double diem_5 = (n >= 5) ? a[4].diemtb : a[n - 1].diemtb;
    
    for (int i = 0; i < n; i++){
        if (a[i].diemtb < diem_5) break;
        printf("%s %.2lf\n", a[i].hoTen, a[i].diemtb);
    }
    
    return 0;
}
